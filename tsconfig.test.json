{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": ".test-dist",
    "isolatedModules": false,
    "incremental": false,
    "jsx": "react-jsx"
  },
  "include": [
    "src/engine/**/*.ts",
    "src/fixtures/**/*.ts",
    "src/demo/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
